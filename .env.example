# ---------------------------------------------------------------------------
# Model provider
# ---------------------------------------------------------------------------
# auto = use whichever key is present (Anthropic first, then Google).
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Throughput — swapping a free key for a paid one is configuration only.
# ---------------------------------------------------------------------------
# Free tier (~5 requests/minute): keep concurrency low and let only the four
# hero clients use the model, so a demo run finishes without hitting 429s.
TICK_CONCURRENCY=3
DEMO_FAST=true
LLM_MAX_RETRIES=4
#
# Paid tier: every invoice gets a real model decision.
#   TICK_CONCURRENCY=12
#   DEMO_FAST=false
#   LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Razorpay  (declare each key ONCE — a duplicate later in this file silently
# overrides the earlier one, which is how a placeholder shadowed a real key)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PUBLIC_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Leave DEMO_TOKEN empty for local dev; set it anywhere reachable, or /reset
# will delete every invoice and audit row for anyone who finds it.
DEMO_TOKEN=
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/revenueguard
REDIS_URL=redis://redis:6379/0
SLACK_WEBHOOK_URL=

# Frontend (must be set at BUILD time for a deployed dashboard)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
